# ═══════════════════════════════════════════════════════════════════════════
# CineSense — Environment Variables Template
# Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════════════════════════════

# TMDB API key (required for poster images and title resolution)
TMDB_API_KEY=your_tmdb_api_key_here

# Firebase Authentication Config
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Server binding
PORT=8000
HOST=0.0.0.0

# CORS allowed origins (comma-separated, use * for development)
CORS_ORIGINS=*

# Data and model directories (relative to imdb_sentiment_classifier/)
CINESENSE_DATA_DIR=data
CINESENSE_MODEL_DIR=models

# Maximum reviews to scrape per source
CINESENSE_MAX_REVIEWS_PER_SOURCE=1000
